# Production Postgres connection string (the same DB the letmepost API uses).
# The dashboard only ever runs SELECTs, wrapped in read-only transactions.
# Recommended: point this at a dedicated read-only role or a Neon read replica.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Shared secret that gates the entire dashboard. Use a long random string.
# The raw value never leaves the server; the cookie only stores its SHA-256.
DASHBOARD_AUTH_KEY=change-me-to-a-long-random-string
