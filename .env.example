# Production Postgres connection string (the same DB the letmepost API uses).
# The dashboard only ever runs SELECTs, wrapped in read-only transactions.
# Recommended: point this at a dedicated read-only role or a Neon read replica.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Shared secret that gates the entire dashboard. Use a long random string.
# The raw value never leaves the server; the cookie only stores its SHA-256.
DASHBOARD_AUTH_KEY=change-me-to-a-long-random-string

# --- Impersonation (optional) ---------------------------------------------
# Both must be set for the "Impersonate" button to work; with either missing
# the button reports that impersonation isn't configured, and the API endpoint
# stays disabled on its side too.
#
# Origin of the letmepost API (better-auth is mounted at /api/auth).
LETMEPOST_AUTH_URL=https://api.letmepost.dev
# Must match ADMIN_IMPERSONATION_SECRET in the API's env. Minimum 32 chars —
# generate with `openssl rand -base64 32`.
ADMIN_IMPERSONATION_SECRET=change-me-min-32-chars-shared-with-the-api
